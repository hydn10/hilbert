@PACKAGE_INIT@

if(@project_package_requires_fftw@)
    include(CMakeFindDependencyMacro)

    # A static Hilbert target retains a link-only reference to FFTW. The
    # installed package carries the dependency-normalization module so its
    # consumers do not need to know provider target names.
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(FFTW3)
    list(POP_FRONT CMAKE_MODULE_PATH)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")

check_required_components("@PROJECT_NAME@")
